datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER

  @@map("user_role")
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
  LOST

  @@map("asset_status")
}

enum MovementType {
  ASSIGNMENT
  RETURN
  TRANSFER
  LOCATION_CHANGE
  RETIREMENT

  @@map("movement_type")
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("maintenance_status")
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("maintenance_priority")
}

model User {
  id           String    @id @default(cuid()) @db.VarChar(32)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String    @db.VarChar(255)
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  performedMovements AssetMovement[]
  openedMaintenances Maintenance[]       @relation("OpenedByUser")
  closedMaintenances Maintenance[]       @relation("ClosedByUser")
  auditLogs          AuditLog[]

  @@map("users")
}

model Session {
  id               String   @id @default(cuid()) @db.VarChar(32)
  userId           String   @map("user_id") @db.VarChar(32)
  sessionTokenHash String   @unique @map("session_token_hash") @db.VarChar(64)
  ipAddress        String   @map("ip_address") @db.VarChar(45)
  userAgent        String   @map("user_agent") @db.Text
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], name: "idx_sessions_user_expires")
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid()) @db.VarChar(32)
  userId    String    @map("user_id") @db.VarChar(32)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Employee {
  id             String   @id @default(cuid()) @db.VarChar(32)
  employeeNumber String   @unique @map("employee_number") @db.VarChar(64)
  name           String   @db.VarChar(255)
  email          String   @unique @db.VarChar(255)
  department     String   @db.VarChar(128)
  position       String   @db.VarChar(128)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assignedAssets Asset[]
  movementsFrom  AssetMovement[] @relation("FromEmployee")
  movementsTo    AssetMovement[] @relation("ToEmployee")

  @@map("employees")
}

model Category {
  id          String   @id @default(cuid()) @db.VarChar(32)
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assets Asset[]

  @@map("categories")
}

model Location {
  id        String   @id @default(cuid()) @db.VarChar(32)
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(128)
  building  String   @db.VarChar(128)
  floor     String?  @db.VarChar(32)
  room      String?  @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assets        Asset[]
  movementsFrom AssetMovement[] @relation("FromLocation")
  movementsTo   AssetMovement[] @relation("ToLocation")

  @@map("locations")
}

model Asset {
  id                 String      @id @default(cuid()) @db.VarChar(32)
  patrimonyNumber    String      @unique @map("patrimony_number") @db.VarChar(64)
  name               String      @db.VarChar(255)
  categoryId         String      @map("category_id") @db.VarChar(32)
  locationId         String      @map("location_id") @db.VarChar(32)
  assignedEmployeeId String?     @map("assigned_employee_id") @db.VarChar(32)
  brand              String      @db.VarChar(128)
  model              String      @db.VarChar(128)
  serialNumber       String?     @map("serial_number") @db.VarChar(128)
  status             AssetStatus @default(AVAILABLE)
  purchaseDate       DateTime    @map("purchase_date") @db.Date
  purchaseValue      Decimal     @map("purchase_value") @db.Decimal(12, 2)
  description        String?     @db.Text
  version            Int         @default(1)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  category         Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location         Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  assignedEmployee Employee?       @relation(fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  movements        AssetMovement[]
  maintenances     Maintenance[]

  @@index([status, categoryId, locationId], name: "idx_assets_status_category_location")
  @@index([assignedEmployeeId], name: "idx_assets_assigned_employee")
  @@index([serialNumber], name: "idx_assets_serial_number")
  @@map("assets")
}

model AssetMovement {
  id                 String       @id @default(cuid()) @db.VarChar(32)
  movementNumber     String       @unique @map("movement_number") @db.VarChar(64)
  assetId            String       @map("asset_id") @db.VarChar(32)
  fromEmployeeId     String?      @map("from_employee_id") @db.VarChar(32)
  toEmployeeId       String?      @map("to_employee_id") @db.VarChar(32)
  fromLocationId     String       @map("from_location_id") @db.VarChar(32)
  toLocationId       String       @map("to_location_id") @db.VarChar(32)
  reason             String       @db.VarChar(255)
  movementType       MovementType @map("movement_type")
  performedByUserId  String       @map("performed_by_user_id") @db.VarChar(32)
  metadata           Json         @default("{}") @db.JsonB
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  fromEmployee   Employee? @relation("FromEmployee", fields: [fromEmployeeId], references: [id], onDelete: Restrict)
  toEmployee     Employee? @relation("ToEmployee", fields: [toEmployeeId], references: [id], onDelete: Restrict)
  fromLocation   Location  @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     Location  @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  performedByUser User     @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([assetId, createdAt(sort: Desc)], name: "idx_movements_asset_created")
  @@index([toEmployeeId, createdAt(sort: Desc)], name: "idx_movements_to_employee")
  @@map("asset_movements")
}

model Maintenance {
  id              String              @id @default(cuid()) @db.VarChar(32)
  ticketNumber    String              @unique @map("ticket_number") @db.VarChar(64)
  assetId         String              @map("asset_id") @db.VarChar(32)
  title           String              @db.VarChar(255)
  description     String              @db.Text
  status          MaintenanceStatus   @default(OPEN)
  priority        MaintenancePriority @default(MEDIUM)
  cost            Decimal?            @db.Decimal(12, 2)
  openedByUserId  String              @map("opened_by_user_id") @db.VarChar(32)
  closedByUserId  String?             @map("closed_by_user_id") @db.VarChar(32)
  openedAt        DateTime            @default(now()) @map("opened_at") @db.Timestamptz
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz
  resolutionNotes String?             @map("resolution_notes") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  asset        Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  openedByUser User  @relation("OpenedByUser", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedByUser User? @relation("ClosedByUser", fields: [closedByUserId], references: [id], onDelete: Restrict)

  @@index([assetId, status], name: "idx_maintenance_asset_status")
  @@index([status, priority, createdAt(sort: Desc)], name: "idx_maintenance_status_priority")
  @@map("maintenance")
}

model AuditLog {
  id           String   @id @default(cuid()) @db.VarChar(32)
  eventName    String   @map("event_name") @db.VarChar(128)
  actorUserId  String?  @map("actor_user_id") @db.VarChar(32)
  ipAddress    String   @map("ip_address") @db.VarChar(45)
  userAgent    String   @map("user_agent") @db.Text
  requestId    String   @map("request_id") @db.VarChar(64)
  traceId      String?  @map("trace_id") @db.VarChar(64)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String   @map("resource_id") @db.VarChar(64)
  changes      Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt(sort: Desc)], name: "idx_audit_logs_resource")
  @@index([actorUserId, createdAt(sort: Desc)], name: "idx_audit_logs_actor")
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String   @id @default(cuid()) @db.VarChar(32)
  key          String   @unique @db.VarChar(128)
  endpoint     String   @db.VarChar(255)
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body") @db.JsonB
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([expiresAt], name: "idx_idempotency_expires")
  @@map("idempotency_records")
}
