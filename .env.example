# Node Environment
NODE_ENV=development
PORT=4000

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Database Configuration
DATABASE_URL=postgresql://veylix_user:veylix_secret_pass@localhost:5432/veylix_db?schema=public

# Security & Sessions
SESSION_SECRET=a_very_secure_and_long_random_session_secret_min_32_bytes_long_key_sample
SESSION_COOKIE_NAME=veylix_session
SESSION_MAX_AGE_SECONDS=86400

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging & Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=veylix-api
